// Query 1 - Recent Azure Activity Events

AzureActivity
| sort by TimeGenerated desc
| take 20


// Query 2 - Successful Azure Operations

AzureActivity
| where ActivityStatusValue == "Success"
| sort by TimeGenerated desc
| project TimeGenerated, OperationNameValue, Caller, ResourceGroup
| take 20


// Query 3 - Block 3 Resource Group Activity

AzureActivity
| where ResourceGroup =~ "rg-block3-runtime-security"
| sort by TimeGenerated desc
| project TimeGenerated, OperationNameValue, ActivityStatusValue, Caller, ResourceId


// Query 4 - Most Common Azure Operations

AzureActivity
| summarize EventCount=count() by OperationNameValue
| sort by EventCount desc


// Query 5 - Failed Azure Operations

AzureActivity
| where ActivityStatusValue =~ "Failed"
| sort by TimeGenerated desc
| project TimeGenerated, OperationNameValue, Caller, ResourceGroup, ResourceId